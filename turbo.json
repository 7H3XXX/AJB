{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "envMode": "loose",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "DEV_TEAM_EMAILS",
    "LOGGER_COLORS",
    "LOGGER_JSON",
    "API_DOCS_PATH",
    "PROJECT_TITLE",
    "PROJECT_DESCRIPTION",
    "PROJECT_VERSION",
    "SMTP_SERVER",
    "SMTP_PORT",
    "SMTP_USERNAME",
    "SMTP_PASSWORD",
    "SMTP_SSL",
    "DATABASE_HOST",
    "DATABASE_NAME",
    "DATABASE_USER",
    "DATABASE_PWD",
    "DATABASE_PORT",
    "DATABASE_SSL",
    "MINIO_HOST",
    "MINIO_PORT",
    "MINIO_SSL",
    "MINIO_ACCESS_KEY",
    "MINIO_SECRET_KEY",
    "MINIO_DEFAULT_BUCKET",
    "MINIO_DEFAULT_REGION",
    "JWT_SECRET",
    "JWT_EXPIRY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NODE_ENV",
        "PORT",
        "DEV_TEAM_EMAILS",
        "LOGGER_COLORS",
        "LOGGER_JSON",
        "API_DOCS_PATH",
        "PROJECT_TITLE",
        "PROJECT_DESCRIPTION",
        "PROJECT_VERSION",
        "SMTP_SERVER",
        "SMTP_PORT",
        "SMTP_USERNAME",
        "SMTP_PASSWORD",
        "SMTP_SSL",
        "DATABASE_HOST",
        "DATABASE_NAME",
        "DATABASE_USER",
        "DATABASE_PWD",
        "DATABASE_PORT",
        "DATABASE_SSL",
        "MINIO_HOST",
        "MINIO_PORT",
        "MINIO_SSL",
        "MINIO_ACCESS_KEY",
        "MINIO_SECRET_KEY",
        "MINIO_DEFAULT_BUCKET",
        "MINIO_DEFAULT_REGION",
        "JWT_SECRET",
        "JWT_EXPIRY"
      ]
    },
    "start": {
      "dependsOn": ["build"],
      "inputs": [".env*"],
      "cache": true,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "PORT",
        "DEV_TEAM_EMAILS",
        "LOGGER_COLORS",
        "LOGGER_JSON",
        "API_DOCS_PATH",
        "PROJECT_TITLE",
        "PROJECT_DESCRIPTION",
        "PROJECT_VERSION",
        "SMTP_SERVER",
        "SMTP_PORT",
        "SMTP_USERNAME",
        "SMTP_PASSWORD",
        "SMTP_SSL",
        "DATABASE_HOST",
        "DATABASE_NAME",
        "DATABASE_USER",
        "DATABASE_PWD",
        "DATABASE_PORT",
        "DATABASE_SSL",
        "MINIO_HOST",
        "MINIO_PORT",
        "MINIO_SSL",
        "MINIO_ACCESS_KEY",
        "MINIO_SECRET_KEY",
        "MINIO_DEFAULT_BUCKET",
        "MINIO_DEFAULT_REGION",
        "JWT_SECRET",
        "JWT_EXPIRY"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "inputs": [".env*"],
      "env": [
        "NODE_ENV",
        "PORT",
        "DEV_TEAM_EMAILS",
        "LOGGER_COLORS",
        "LOGGER_JSON",
        "API_DOCS_PATH",
        "PROJECT_TITLE",
        "PROJECT_DESCRIPTION",
        "PROJECT_VERSION",
        "SMTP_SERVER",
        "SMTP_PORT",
        "SMTP_USERNAME",
        "SMTP_PASSWORD",
        "SMTP_SSL",
        "DATABASE_HOST",
        "DATABASE_NAME",
        "DATABASE_USER",
        "DATABASE_PWD",
        "DATABASE_PORT",
        "DATABASE_SSL",
        "MINIO_HOST",
        "MINIO_PORT",
        "MINIO_SSL",
        "MINIO_ACCESS_KEY",
        "MINIO_SECRET_KEY",
        "MINIO_DEFAULT_BUCKET",
        "MINIO_DEFAULT_REGION",
        "JWT_SECRET",
        "JWT_EXPIRY"
      ]
    },
    "db:generate": {
      "cache": true,
      "persistent": false,
      "env": [
        "NODE_ENV",
        "PORT",
        "DEV_TEAM_EMAILS",
        "LOGGER_COLORS",
        "LOGGER_JSON",
        "API_DOCS_PATH",
        "PROJECT_TITLE",
        "PROJECT_DESCRIPTION",
        "PROJECT_VERSION",
        "SMTP_SERVER",
        "SMTP_PORT",
        "SMTP_USERNAME",
        "SMTP_PASSWORD",
        "SMTP_SSL",
        "DATABASE_HOST",
        "DATABASE_NAME",
        "DATABASE_USER",
        "DATABASE_PWD",
        "DATABASE_PORT",
        "DATABASE_SSL",
        "MINIO_HOST",
        "MINIO_PORT",
        "MINIO_SSL",
        "MINIO_ACCESS_KEY",
        "MINIO_SECRET_KEY",
        "MINIO_DEFAULT_BUCKET",
        "MINIO_DEFAULT_REGION",
        "JWT_SECRET",
        "JWT_EXPIRY"
      ]
    },
    "db:migrate": {
      "cache": false,
      "persistent": false,
      "env": [
        "NODE_ENV",
        "PORT",
        "DEV_TEAM_EMAILS",
        "LOGGER_COLORS",
        "LOGGER_JSON",
        "API_DOCS_PATH",
        "PROJECT_TITLE",
        "PROJECT_DESCRIPTION",
        "PROJECT_VERSION",
        "SMTP_SERVER",
        "SMTP_PORT",
        "SMTP_USERNAME",
        "SMTP_PASSWORD",
        "SMTP_SSL",
        "DATABASE_HOST",
        "DATABASE_NAME",
        "DATABASE_USER",
        "DATABASE_PWD",
        "DATABASE_PORT",
        "DATABASE_SSL",
        "MINIO_HOST",
        "MINIO_PORT",
        "MINIO_SSL",
        "MINIO_ACCESS_KEY",
        "MINIO_SECRET_KEY",
        "MINIO_DEFAULT_BUCKET",
        "MINIO_DEFAULT_REGION",
        "JWT_SECRET",
        "JWT_EXPIRY"
      ]
    }
  }
}
